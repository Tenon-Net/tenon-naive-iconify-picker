{
  "name": "tenon-naive-iconify-picker",
  "version": "0.1.0",
  "description": "Offline-first icon picker for Vue 3 + Naive UI, powered by Iconify. Browse bundled icon sets offline, inject your own local SVGs, or use any online Iconify icon.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "naive-ui",
    "iconify",
    "icon-picker",
    "offline",
    "icons"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@iconify/vue": "^4.0.0 || ^5.0.0",
    "naive-ui": "^2.34.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/vue": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "naive-ui": "^2.41.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-lib-inject-css": "^2.2.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
